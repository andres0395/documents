# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Database (Prisma 7 — the URL is consumed by prisma.config.ts via dotenv).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/citas

# Auth — used to sign the session JWT. Must be at least 32 bytes; the
# recommended way to generate one is:  openssl rand -base64 48
AUTH_SECRET=

# Cron / email — for the daily cita reminder.
# CRON_SECRET protects the /api/cron/daily-reminders route. Vercel
# auto-generates one for cron jobs but you can also set your own so
# you can hit the endpoint manually with curl during testing.
CRON_SECRET=

# Recipient for the daily reminder. If this email matches a registered
# user, only that user's citas are included; otherwise the email lists
# every user's matching citas (admin / team view).
EMAIL_TO=

# Gmail SMTP for sending the reminder. The app password is generated
# at https://myaccount.google.com/apppasswords after enabling 2FA on
# the Google account that owns GMAIL_USER.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional. Defaults to GMAIL_USER if empty. Example:
#   "Citas <noreply@gmail.com>"
EMAIL_FROM=

# Optional. Override only if you switch providers.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true

# Google Drive — pick ONE auth mode. The service prefers OAuth if
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN is set, otherwise it falls back to a
# service account.
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# OAuth mode
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Optional. Defaults to http://localhost.
# GOOGLE_DRIVE_OAUTH_REDIRECT_URI=

# Service-account mode
# GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_DRIVE_PRIVATE_KEY=
# GOOGLE_DRIVE_IMPERSONATE_USER_EMAIL=
